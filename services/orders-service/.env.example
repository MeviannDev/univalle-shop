NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=univalle_orders
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
SWAGGER_PATH=docs

# Solo para desarrollo local. En producción, usa secretos gestionados.
JWT_SECRET=development-only-secret-change-before-deploy-32
INTERNAL_SERVICE_API_KEY=development-only-internal-api-key-change-before-deploy

# Usa "stub" para desarrollo aislado o "http" para integrar los servicios reales.
USERS_ADAPTER=stub
CATALOG_ADAPTER=stub
PAYMENTS_ADAPTER=stub
USERS_SERVICE_URL=http://localhost:3000
CATALOG_SERVICE_URL=http://localhost:3002
PAYMENTS_SERVICE_URL=http://localhost:3003
USERS_TIMEOUT_MS=3000
CATALOG_TIMEOUT_MS=3000
PAYMENTS_TIMEOUT_MS=3000
STUB_PAYMENT_RESULT=PENDING
