NODE_ENV=development
PORT=3003
MONGODB_URI=mongodb://localhost:27019/univalle_payments
MONGODB_DATABASE=univalle_payments

# Usa el mismo valor en Orders, Catalog y Payments. Solo para desarrollo.
INTERNAL_SERVICE_API_KEY=development-only-internal-api-key-change-before-deploy

# auto conserva la simulación por método; también acepta pending, approved o rejected.
PAYMENT_SIMULATION_RESULT=auto

# Actívalo cuando Orders esté disponible para recibir callbacks.
PAYMENT_CALLBACK_ENABLED=false
ORDERS_CALLBACK_BASE_URL=http://localhost:3001/api/orders
PAYMENT_CALLBACK_POLL_INTERVAL_MS=1000
PAYMENT_CALLBACK_TIMEOUT_MS=3000
PAYMENT_CALLBACK_MAX_ATTEMPTS=10
